# Frontend Environment Variables (Vite)
# Note: In local development, Vite proxies '/api' and '/socket.io' to 'http://localhost:5000' automatically (see vite.config.js).
# Only set these variables if deploying to production or connecting to a custom remote backend URL.

# Backend API Base URL (leave blank for local dev proxy)
# VITE_API_URL=http://localhost:5000

# WebSocket Base URL (leave blank for local dev proxy)
# VITE_WS_URL=http://localhost:5000

# ── Demo / presentation mode ─────────────────────────────────────────
# By default the app runs with an in-browser MOCK backend (src/mock/) so every
# page works with fake data and NO server. To use your real backend again,
# uncomment the next line:
# VITE_USE_MOCK=false
