# Used by `npm run build:local` / start_production.bat (vite build --mode localprod).
# A production-optimized build for running on THIS machine: .env.production (Vercel URLs)
# is NOT loaded in this mode, so the app talks to the local backend through the
# /api and /socket.io proxy in vite.config.js - the same server and data as dev mode.
VITE_API_URL=
VITE_WS_URL=
